<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Gallery toolbar chips: Material 3 outlined, checkable — accent border + app-bg fill when idle,
         accent fill + white label when active. Shared by the Photos/Videos/Faved/Select buttons. -->
    <style name="FilterChip" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:checkable">true</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/filter_chip_text</item>
        <item name="backgroundTint">@color/filter_chip_bg</item>
        <item name="strokeColor">@color/osmo_accent</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconTint">@color/filter_chip_text</item>
        <item name="rippleColor">@color/osmo_accent</item>
    </style>

    <!-- A tile in a camera row's swipe menu (item_camera): icon over label, as tall as the darkened pill
         allows. The background (fill + ripple) is set per action. -->
    <style name="SwipeAction">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="SwipeActionIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:tint">@color/white</item>
    </style>

    <style name="SwipeActionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.045</item>
    </style>
</resources>
